{
  "name": "@agentdash/mcp-server",
  "version": "0.1.0",
  "description": "AgentDash MCP Server — onboarding, provisioning, and management via Model Context Protocol",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentdash-mcp": "./dist/stdio.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/stdio.ts src/index.ts --outdir=dist --bundle --platform=node --format=esm --target=node20 --sourcemap --banner:js=\"#!/usr/bin/env node\" --external:@modelcontextprotocol/sdk --external:zod && tsc --emitDeclarationOnly",
    "start": "node dist/stdio.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@paperclipai/shared": "workspace:*",
    "@types/node": "^24.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
