# MKThink AgentDash Environment Configuration
# Copy to ~/.config/agentdash/agentdash.env and fill in <VALUES>
# Generated 2026-07-23 for MKThink on-prem pilot (6-month free trial)

# === Deployment ===
PAPERCLIP_DEPLOYMENT_MODE=authenticated
NODE_ENV=production
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
PAPERCLIP_BIND=lan
# Replace with the Mac mini's LAN IP or Tailscale hostname
PAPERCLIP_ALLOWED_HOSTNAMES=<MKTHINK-MAC-MINI-IP>
PAPERCLIP_PUBLIC_URL=http://<MKTHINK-MAC-MINI-IP>:3100
PAPERCLIP_API_URL=http://127.0.0.1:3100
PAPERCLIP_AUTH_BASE_URL_MODE=explicit
PAPERCLIP_AUTH_PUBLIC_BASE_URL=http://<MKTHINK-MAC-MINI-IP>:3100
PAPERCLIP_MIGRATION_AUTO_APPLY=true

# === Security (generate on-site with: openssl rand -hex 32) ===
BETTER_AUTH_SECRET=<GENERATE_ON_SITE>
PAPERCLIP_AGENT_JWT_SECRET=<GENERATE_ON_SITE>

# === LLM Adapter ===
# Option A: Claude API (recommended — full cost tracking + budget enforcement)
AGENTDASH_DEFAULT_ADAPTER=claude_api
ANTHROPIC_API_KEY=<CUSTOMER_ANTHROPIC_API_KEY>

# Option B: Claude Code CLI (uses subscription, no API key needed, but no cost tracking)
# AGENTDASH_DEFAULT_ADAPTER=claude_local
# DISABLE_AUTOUPDATER=1

# Option C: Local model via Ollama (free, no external dependency)
# AGENTDASH_DEFAULT_ADAPTER=openai_compat
# OPENAI_COMPAT_API_KEY=ollama
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_MODEL=gemma4:12b

# === License ===
AGENTDASH_DEPLOYMENT_KIND=on_prem
AGENTDASH_LICENSE_KEY=<PASTE_THE_LICENCE_KEY_FROM_THE_WELCOME_EMAIL>
AGENTDASH_LICENSE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAaGK1po1qckt8YNbpn8TDXZBOVoTV+0D9RO7/KYG58Jw=\n-----END PUBLIC KEY-----

# === Email (optional — password reset + welcome emails) ===
# RESEND_API_KEY=re_...
# AGENTDASH_EMAIL_FROM='MKThink AgentDash <noreply@mkthink.com>'

# === Issue reporting (optional — "Report an issue" button + MCP tool) ===
# Lets anyone signed in to this board — and any agent on it, from their own
# Claude Code or Codex session — file a bug or feature request without a GitHub
# account of their own. Reports land as issues, labelled `user-report`, stamped
# with who reported them and which instance they came from.
#
# The repo is deliberately OURS, not the customer's: the point of a design
# partner is that what they hit reaches the people who can fix it. The token is
# a fine-grained PAT scoped to Issues:write on that one repo and nothing else —
# it can open issues and cannot read code.
#
# Both unset = feature disabled, button hidden, MCP tool reports unavailable.
# That is a valid deployment, not an error.
# AGENTDASH_GITHUB_ISSUES_REPO=thetangstr/agentdash
# AGENTDASH_GITHUB_ISSUES_TOKEN=github_pat_...

# === Agent sandbox (optional — confines agent subprocesses) ===
# off (default) | loopback (no egress) | direct (443 re-opened).
# Switching this on surfaces which runtime paths the agent CLI needs from
# outside its workspace, which is why every one is listed rather than implied.
# AGENTDASH_AGENT_SANDBOX=direct
#
# Colon-separated absolute paths re-opened READ-WRITE below the home deny. Each
# entry is a hole in the confinement. ~/.hermes is the Hermes venv the wrapper
# execs; ~/.codex is where Codex keeps auth.json and refreshes its OAuth token,
# and where the adapter injects its skills on every run.
# AGENTDASH_AGENT_SANDBOX_ALLOW=/Users/yang/.hermes:/Users/yang/.codex
#
# Read-only (and executable) re-openings — the agent's own runtime.
# AGENTDASH_AGENT_SANDBOX_READONLY=/Users/yang/.local/bin:/Users/yang/.mcporter
#
# A synthetic HOME for agent subprocesses, so a tool probing $HOME misses the
# operator's personal config instead of reading it.
# AGENTDASH_AGENT_SANDBOX_HOME=/Users/yang/.paperclip/agent-home

# === Codex adapter (optional — only for codex_local agents) ===
# The binary the adapter drives. It must be the codex CLI: every invocation
# starts with `exec --json --skip-git-repo-check`, and codex-acp answers those
# with `unrecognized arguments`.
# AGENTDASH_CODEX_COMMAND=/opt/homebrew/bin/codex
#
# Per-agent, in adapterConfig.env rather than here: CODEX_HOME must point at the
# real Codex home (~/.codex). The sandbox gives the child a synthetic HOME, so
# without it Codex finds no credentials and every run returns 401 with no
# bearer at all — while the preflight, which reads the server's own home,
# reports the agent as authenticated.

# === Hermes token metering (optional) ===
# Where Hermes keeps state.db, read after each run for session_model_usage.
# Defaults to $HERMES_HOME/state.db, then ~/.hermes/state.db.
# AGENTDASH_HERMES_STATE_DB=/Users/yang/.hermes/state.db

