# Reference copy of the Caddyfile that deploy/relocate.sh generates on the
# host (the live one is ~/.config/agentdash/Caddyfile and has the real values).
# See deploy/caddy/README.md for why each of these blocks has to exist.
#
# This copy holds no real host names or addresses. Caddy fills them in from
# the environment when it loads the file, so to run it directly set:
#
#   AGENTDASH_TLS_DIR       directory holding mkmini-multi.pem / -key.pem
#   AGENTDASH_MDNS_HOST     the box's mDNS name (default mkmini.local)
#   AGENTDASH_TAILNET_HOST  the MagicDNS name, <tailnet-host>.ts.net
#   AGENTDASH_LAN_IP        the box's LAN address, <lan-ip>
#   AGENTDASH_TAILNET_IP    the box's tailnet address, <tailnet-ip>
#
# Keep the real values in the operator's private env file or runbook, never
# in this repository.

{
	auto_https disable_redirects
}

(agentdash_tls) {
	tls {$AGENTDASH_TLS_DIR}/mkmini-multi.pem {$AGENTDASH_TLS_DIR}/mkmini-multi-key.pem
}

# --- mkboard ---
https://{$AGENTDASH_MDNS_HOST:mkmini.local}:3112, https://{$AGENTDASH_TAILNET_HOST}:3112, https://{$AGENTDASH_LAN_IP}:3112, https://{$AGENTDASH_TAILNET_IP}:3112 {
	import agentdash_tls
	reverse_proxy 127.0.0.1:3102
}

# --- uat ---
https://{$AGENTDASH_MDNS_HOST:mkmini.local}:3113, https://{$AGENTDASH_TAILNET_HOST}:3113, https://{$AGENTDASH_LAN_IP}:3113, https://{$AGENTDASH_TAILNET_IP}:3113 {
	import agentdash_tls
	reverse_proxy 127.0.0.1:3103
}
