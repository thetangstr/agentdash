{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "cloud/Dockerfile",
    "watchPatterns": ["cloud/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "node dist/migrate.js",
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}
