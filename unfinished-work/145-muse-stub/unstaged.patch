 // ---------------------------------------------------------------------------
 /** DCR-registered clients: client_id -> { client_name, redirect_uris, client_uri? } */
 const dcrClients = new Map();
+// Pre-registered clients for hosts (like Meta Muse) that ask the user for a
+// Client ID instead of registering themselves. Format:
+//   STUB_PRECONFIGURED_CLIENTS="muse-spike=https://a/cb|https://b/cb;other=..."
+// An empty redirect list is allowed: /authorize then logs the host's real
+// redirect_uri as authorize_redirect_mismatch, and it can be added on restart.
+for (const entry of (process.env.STUB_PRECONFIGURED_CLIENTS ?? "").split(";").filter(Boolean)) {
+  const [id, uris = ""] = entry.split("=");
+  dcrClients.set(id, { client_name: id, redirect_uris: uris.split("|").filter(Boolean), token_endpoint_auth_method: "none" });
+}
 /** CIMD documents fetched from client_id URLs: url -> fetched doc */
 const cimdDocuments = new Map();
