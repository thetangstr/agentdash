{
  "name": "@agentdash/cloud-control",
  "version": "0.1.0",
  "private": true,
  "description": "AgentDash self-serve cloud control plane (accounts, boxes, provisioning jobs). Its own database; never the box schema.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rm -rf dist/db/migrations && cp -r src/db/migrations dist/db/migrations",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "admin": "tsx src/admin/cli.ts",
    "generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "libsodium-wrappers": "^0.8.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/libsodium-wrappers": "^0.8.2",
    "@types/node": "^24.6.0",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.9",
    "embedded-postgres": "^18.1.0-beta.16",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
