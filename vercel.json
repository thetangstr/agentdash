{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run preflight:workspace-links && pnpm --filter @paperclipai/adapter-utils build && pnpm --filter @paperclipai/ui build",
  "outputDirectory": "ui/dist",
  "rewrites": [
    {
      "source": "/api/cloud/:path*",
      "destination": "https://cloud-control-production.up.railway.app/api/cloud/:path*"
    },
    {
      "source": "/api/invites/validate",
      "destination": "https://cloud-control-production.up.railway.app/api/invites/validate"
    },
    {
      "source": "/api/:path*",
      "destination": "https://cloud-control-production.up.railway.app/api/gone"
    },
    {
      "source": "/:path((?!api/|api$).*)",
      "destination": "/index.html"
    }
  ]
}
